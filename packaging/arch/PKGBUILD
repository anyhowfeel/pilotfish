# Maintainer: anyhowfeel <346877873+anyhowfeel@users.noreply.github.com>
pkgname=wirelens
pkgver=0.3.0
pkgrel=1
pkgdesc="Prototype desktop packet viewer on top of tshark, written in Rust with egui"
arch=('x86_64' 'aarch64')
url="https://github.com/anyhowfeel/wirelens"
license=('GPL-3.0-or-later')
depends=('wireshark-cli' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'mesa')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/wirelens "$pkgdir/usr/bin/wirelens"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/wirelens.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=wirelens
GenericName=Packet viewer
Comment=Prototype packet viewer on top of tshark
Exec=wirelens %f
Icon=wirelens
Terminal=false
Categories=Network;Monitor;
MimeType=application/vnd.tcpdump.pcap;application/x-pcapng;
DESKTOP
  install -Dm644 assets/logo/wirelens.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wirelens.svg"
  install -Dm644 assets/logo/wirelens-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/wirelens.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
